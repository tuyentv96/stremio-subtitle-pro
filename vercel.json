{
  "version": 2,
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/configure"
    },
    {
      "source": "/configure",
      "destination": "/api/configure"
    },
    {
      "source": "/:config/manifest.json",
      "destination": "/api/manifest"
    },
    {
      "source": "/:config/subtitles/movie/:id.json",
      "destination": "/api/subtitles/movie/:id"
    },
    {
      "source": "/:config/subtitles/series/:id.json",
      "destination": "/api/subtitles/series/:id"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    }
  ]
}
