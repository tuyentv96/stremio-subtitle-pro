{
  "version": 2,
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/configure"
    },
    {
      "source": "/configure",
      "destination": "/api/configure"
    },
    {
      "source": "/debug/:config/manifest.json",
      "destination": "/api/debug-manifest?config=:config"
    },
    {
      "source": "/:config/manifest.json",
      "destination": "/api/manifest?config=:config"
    },
    {
      "source": "/:config/subtitles/movie/:id.json",
      "destination": "/api/subtitles/movie/:id?config=:config"
    },
    {
      "source": "/:config/subtitles/series/:id.json",
      "destination": "/api/subtitles/series/:id?config=:config"
    },
    {
      "source": "/:config/subtitles/merged/:pairId.srt",
      "destination": "/api/subtitles/merged/:pairId?config=:config"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    }
  ]
}
