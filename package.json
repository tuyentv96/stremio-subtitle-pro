{
  "name": "subtitle-pro-plugin",
  "version": "1.0.0",
  "description": "Stremio addon for multi-provider subtitle search with OpenSubtitles and Subsource",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "deploy": "vercel --prod",
    "test": "node test-config.js",
    "start": "node server.js",
    "stop": "lsof -ti:3000 | xargs kill -9 2>/dev/null || true"
  },
  "keywords": [
    "stremio",
    "subtitles",
    "opensubtitles",
    "subsource",
    "addon"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "stremio-addon-sdk": "^1.6.10",
    "opensubtitles.com": "^1.1.0",
    "p-queue": "^8.0.0",
    "node-fetch": "^3.0.0"
  }
}
